{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@sematica/source"],
    "baseUrl": ".",
    "paths": {
      "@sematicca/core": ["libs/core/src/index.ts"],
      "@sematicca/knex": ["libs/knex/src/index.ts"],
      "@sematicca/react": ["libs/react/src/index.ts"]
    }
  }
}